# Compose interpolation only; Spring Boot does not load .env files. Copy this to
# .env if desired, and export matching values separately for ./gradlew bootRun.
AUKCIJE_DB_NAME=aukcije
AUKCIJE_DB_USER=aukcije
AUKCIJE_DB_PORT=5432

# Do not put the password in this file. Store it at the ignored path below and
# export AUKCIJE_DB_PASSWORD only for the Gradle application process.
AUKCIJE_DB_PASSWORD_FILE=./.secrets/postgres-password

# Optional normal-operation schedule overrides. '-' safely pauses the daily
# source-to-map refresh without changing database state.
EAUKCIJA_REFRESH_SCHEDULE_CRON=0 0 3 * * *
EAUKCIJA_REFRESH_SCHEDULE_ZONE=Europe/Belgrade
EAUKCIJA_REFRESH_RUNNING_STALE_AFTER=PT15M

# The private dev POC automatically configures RGZ and enriches retained auctions.
# No manually invented dataset edition or copied hashes are needed.
# See documentation/RGZ_PARCEL_OPERATIONS.md. Common/prod defaults remain off.
# Uncomment to opt OUT of all RGZ networking on startup:
# RGZ_ENABLED=false
# Or retain manual refresh only (no background refinement):
# RGZ_WARMUP_ENABLED=false
# Live stop (no restart): create data/control/rgz.disabled.
# ./start.sh loads .env; direct bootRun needs exported variables.
