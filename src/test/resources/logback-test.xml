<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Container startup and migration are the two things worth seeing when an
         integration test fails in CI, where there is no shell to poke at. -->
    <logger name="org.testcontainers" level="INFO"/>
    <logger name="org.flywaydb" level="INFO"/>
    <logger name="rs.sud.eaukcija" level="INFO"/>
</configuration>
