# Compose interpolation only; Spring Boot does not load .env files. Copy this to
# .env if desired, and export matching values separately for ./gradlew bootRun.
AUKCIJE_DB_NAME=aukcije
AUKCIJE_DB_USER=aukcije
AUKCIJE_DB_PORT=5432

# Do not put the password in this file. Store it at the ignored path below and
# export AUKCIJE_DB_PASSWORD only for the Gradle application process.
AUKCIJE_DB_PASSWORD_FILE=./.secrets/postgres-password
